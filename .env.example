# Supabase project URL, for example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public browser key used by the Next.js client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only admin key used in API routes/webhooks. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public app origin used for auth redirects in production
# Local example: http://localhost:3000
# Production example: https://only-fans-saa-s.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
ANTHROPIC_API_KEY=
